# ArmorIQ API key from platform.armoriq.ai (Settings -> API keys)
ARMORIQ_API_KEY=ak_live_...
# Any OpenAI-compatible LLM gateway (we use TokenRouter)
TOKENROUTER_API_KEY=sk-...
LLM_BASE_URL=https://api.tokenrouter.com/v1
# Bearer token ArmorIQ's proxy sends to our MCP servers (random string)
MCP_TOKEN=change-me
# Public base URL of this service (MCP servers are registered as $PUBLIC_URL/mcp/<id>)
PUBLIC_URL=https://your-app.example.com
